.hero {
  background: #1a2332;
}

.hero .card-title,
.kicker {
  color: #ffffff;
}

.kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #c4a35a;
  margin-bottom: 8rpx;
}

.hero .card-sub {
  color: #c9d0d8;
}

.field {
  margin-top: 20rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 10rpx;
}

.input,
.picker-value {
  background: #f7f8fa;
  border: 1rpx solid #e6e8eb;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1a2332;
  box-sizing: border-box;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin-left: -12rpx;
  margin-right: -12rpx;
}

.grid .field {
  width: 50%;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  margin-top: 8rpx;
  font-size: 28rpx;
}

.calc {
  margin-top: 28rpx;
}

.result-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.big {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.1;
  color: #1a2332;
}

.unit {
  font-size: 28rpx;
  font-weight: 500;
  margin-left: 8rpx;
}

.pill {
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
}

.pill.ok {
  color: #166534;
  background: #dcfce7;
}

.pill.warn {
  color: #92400e;
  background: #fef3c7;
}

.pill.bad {
  color: #991b1b;
  background: #fee2e2;
}

.metrics {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.metric {
  width: 50%;
  margin-bottom: 20rpx;
}

.metric-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a365d;
}

.metric-label {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.risk {
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  background: #fff7ed;
  color: #9a3412;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.talk {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1a2332;
}

.gap {
  margin-top: 16rpx;
}
