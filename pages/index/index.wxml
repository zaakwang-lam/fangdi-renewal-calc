<view class="container">
  <text>房抵续贷测算</text>
  <picker mode="selector" range="{{banks}}" value="{{bankIndex}}" bindchange="onBank">
    <view>口径：{{banks[bankIndex]}}</view>
  </picker>
  <input type="digit" placeholder="当前估值（万）" data-k="currentValue" value="{{form.currentValue}}" bindinput="onNum" />
  <input type="digit" placeholder="原评估（万）" data-k="originalValue" value="{{form.originalValue}}" bindinput="onNum" />
  <input type="digit" placeholder="剩余本金（万）" data-k="remainingPrincipal" value="{{form.remainingPrincipal}}" bindinput="onNum" />
  <input type="digit" placeholder="房龄" data-k="age" value="{{form.age}}" bindinput="onNum" />
  <input type="digit" placeholder="借款人年龄" data-k="borrowerAge" value="{{form.borrowerAge}}" bindinput="onNum" />
  <input type="digit" placeholder="剩余年限" data-k="remainingYears" value="{{form.remainingYears}}" bindinput="onNum" />
  <button bindtap="onCalc">计算</button>
  <view wx:if="{{result.ok}}">
    <text>{{result.status}} · 建议 {{result.suggested}} 万 · 上限 {{result.maxLoan}} 万</text>
    <text>{{result.talk}}</text>
  </view>
</view>
